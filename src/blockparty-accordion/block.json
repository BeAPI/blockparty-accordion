{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "blockparty/accordion",
	"version": "1.2.1",
	"title": "Accordion",
	"category": "widgets",
	"description": "Display a list of elements that can be expanded and collapsed.",
	"attributes": {
		"firstItemOpenByDefault": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": true
		}
	},
	"example": {
		"attributes": {
			"firstItemOpenByDefault": true
		},
		"innerBlocks": [
			{
				"name": "blockparty/accordion-item",
				"attributes": {
					"openByDefault": true
				},
				"innerBlocks": [
					{
						"name": "blockparty/accordion-summary",
						"attributes": {
							"label": "Lorem ipsum"
						}
					},
					{
						"name": "blockparty/accordion-panel",
						"innerBlocks": [
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Lorem ipsum"
								}
							}
						]
					}
				]
			},
			{
				"name": "blockparty/accordion-item",
				"innerBlocks": [
					{
						"name": "blockparty/accordion-summary",
						"attributes": {
							"label": "Lorem ipsum"
						}
					},
					{
						"name": "blockparty/accordion-panel",
						"innerBlocks": [
							{
								"name": "core/paragraph",
								"attributes": {
									"content": "Lorem ipsum"
								}
							}
						]
					}
				]
			}
		]
	},
	"textdomain": "blockparty-accordion",
	"editorScript": "file:./index.js",
	"viewScript": "file:./script.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
