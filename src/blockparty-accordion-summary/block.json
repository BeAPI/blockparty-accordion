{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 2,
	"name": "blockparty/accordion-summary",
	"parent": [
		"blockparty/accordion-item"
	],
	"version": "1.3.2",
	"title": "Summary",
	"category": "widgets",
	"description": "Title of the accordion item.",
	"usesContext": [
		"blockparty/headingLevel"
	],
	"supports": {
		"html": false,
		"anchor": false,
		"align": [
			"wide",
			"full"
		],
		"lock": true,
		"reusable": false,
		"color": {
			"background": true,
			"text": true
		}
	},
	"attributes": {
		"label": {
			"type": "string"
		},
		"hasIcon": {
			"type": "boolean",
			"value": false
		},
		"headingLevel": {
			"type": "number",
			"default": 3,
			"enum": [
				2,
				3,
				4,
				5,
				6
			]
		}
	},
	"textdomain": "blockparty-accordion",
	"editorScript": "file:./index.js"
}
