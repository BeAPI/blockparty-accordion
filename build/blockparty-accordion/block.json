{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 2,
  "name": "blockparty/accordion",
  "version": "1.2.0",
  "title": "Accordion",
  "category": "widgets",
  "description": "Display a list of elements that can be expanded and collapsed.",
  "attributes": {
    "firstItemOpenByDefault": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    }
  },
  "textdomain": "blockparty-accordion",
  "editorScript": "file:./index.js",
  "viewScript": "file:./script.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}