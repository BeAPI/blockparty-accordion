{
	"name": "blockparty-accordion",
	"version": "1.3.2",
	"description": "Accessible Accordion block for WordPress",
	"author": "Be API Technical team",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start",
		"env:start": "wp-env start",
		"env:start-tests": "wp-env start --xdebug=coverage --config=./.wp-env.test.json",
		"env:start-ci": "wp-env start --config=./.wp-env.test.json",
		"env:stop": "wp-env stop",
		"env:stop-tests": "wp-env stop --config=./.wp-env.test.json",
		"env:reset-tests": "wp-env destroy --config=./.wp-env.test.json --force && wp-env start --xdebug=coverage --config=./.wp-env.test.json",
		"env:cli-test": "wp-env run cli --config=./.wp-env.test.json",
		"env": "wp-env",
		"test:php": "wp-env run cli --config=./.wp-env.test.json --env-cwd=wp-content/plugins/blockparty-accordion/ -- ./vendor/bin/phpunit",
		"test:php:coverage": "wp-env run cli --config=./.wp-env.test.json --env-cwd=wp-content/plugins/blockparty-accordion/ -- ./vendor/bin/phpunit --coverage-html=./coverage/ --coverage-text",
		"test:unit:js": "wp-scripts test-unit-js",
		"test:e2e": "wp-scripts test-playwright --config tests/playwright/playwright.config.js",
		"test:e2e-debug": "wp-scripts test-playwright --headed --config tests/playwright/playwright.config.js",
		"test:e2e-ui": "wp-scripts test-playwright --ui --config tests/playwright/playwright.config.js",
		"make-pot": "wp i18n make-pot . languages/blockparty-accordion.pot --slug=blockparty-accordion --domain=blockparty-accordion --exclude=node_modules,src",
		"make-json": "wp i18n make-json languages/ --no-purge",
		"bump": "bash tests/bin/bump.sh"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@typescript-eslint/eslint-plugin": "^6.21.0",
		"@typescript-eslint/parser": "^6.21.0",
		"@wordpress/blocks": "^12.35.0",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/eslint-plugin": "^17.11.0",
		"@wordpress/prettier-config": "^3.11.0",
		"@wordpress/scripts": "^32.6.0",
		"@wordpress/stylelint-config": "^21.37.0",
		"eslint-config-prettier": "^8.5.0",
		"stylelint-config-recess-order": "^3.0.0",
		"stylelint-scss": "^4.3.0"
	},
	"dependencies": {
		"@beapi/be-a11y": "^2.0.0",
		"@beapi/icons": "^1.2.7",
		"@wordpress/components": "^27.2.0",
		"@wordpress/data": "^9.24.0",
		"@wordpress/icons": "^15.0.0",
		"@wp-now/wp-now": "^0.1.66"
	},
	"prettier": "@wordpress/prettier-config",
	"engines": {
		"node": ">=20",
		"npm": ">=10"
	},
	"volta": {
		"node": "24.15.0"
	}
}
