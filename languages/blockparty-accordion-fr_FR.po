#. Plugin Name of the plugin
#: blockparty-accordion.php
msgid "Blockparty Accordion"
msgstr "Blockparty Accordéon"

#. Description of the plugin
#: blockparty-accordion.php
msgid "Accessible Accordion block for WordPress editor."
msgstr "Bloc Accordéon Accessible pour l’éditeur de WordPress."

#. Author of the plugin
#: blockparty-accordion.php
msgid "Be API Technical team"
msgstr "Be API Technical team"

#. Author URI of the plugin
#: blockparty-accordion.php
msgid "https://beapi.fr"
msgstr "https://beapi.fr"

#: build/blockparty-accordion-summary/index.js:1
msgid "Icon"
msgstr "Icône"

#: build/blockparty-accordion-summary/index.js:1
msgid "Summary…"
msgstr "Titre…"

#: build/blockparty-accordion/index.js:1
msgid "Accessibility"
msgstr "Accessibilité"

#: build/blockparty-accordion/index.js:1
msgid "Summary heading level"
msgstr "Niveau de titre des entrées"

#: build/blockparty-accordion/index.js:1
msgid "Define the heading level for each accordion summary."
msgstr "Définissez le niveau de titre de chaque entrée de l'accordéon."

#. translators: %d: heading level number (2–6).
#: build/blockparty-accordion/index.js:2
msgid "Heading level %d"
msgstr "Niveau de titre %d"

#: build/blockparty-accordion/index.js:2
msgid "Settings"
msgstr "Réglages"

#: build/blockparty-accordion/index.js:2
msgid "Open first item by default"
msgstr "Ouvrir le premier élément par défaut"

#: build/blockparty-accordion/index.js:2
msgid ""
"The first item will be opened by default when the page loads if this option "
"is enabled."
msgstr ""
"La première entrée sera ouverte par défaut au chargement de la page si cette "
"option est activé."

#: build/blockparty-accordion/index.js:2
msgid "Auto-close"
msgstr "Fermeture automatique"

#: build/blockparty-accordion/index.js:2
msgid "When enabled, opening a panel closes any other open panel."
msgstr ""
"Si c’est activé, les panneaux seront automatiquement fermés si un autre "
"panneau est ouvert."

#: build/blockparty-accordion-item/block.json
msgctxt "block title"
msgid "Item"
msgstr "Élément"

#: build/blockparty-accordion-item/block.json
msgctxt "block description"
msgid "Element of the accordion block."
msgstr "Élément du bloc accordéon."

#: build/blockparty-accordion-panel/block.json
msgctxt "block title"
msgid "Panel"
msgstr "Panneau"

#: build/blockparty-accordion-panel/block.json
msgctxt "block description"
msgid "Contains the hidden or revealed content of the accordion item."
msgstr "Contient le contenu affiché ou masqué de l’élément d’accordéon."

#: build/blockparty-accordion-summary/block.json
msgctxt "block title"
msgid "Summary"
msgstr "Titre"

#: build/blockparty-accordion-summary/block.json
msgctxt "block description"
msgid "Title of the accordion item."
msgstr "Titre de l’élément d’accordéon."

#: build/blockparty-accordion/block.json
msgctxt "block title"
msgid "Accordion"
msgstr "Accordéon"

#: build/blockparty-accordion/block.json
msgctxt "block description"
msgid "Display a list of elements that can be expanded and collapsed."
msgstr "Affiche une liste d’éléments qui peuvent être dépliés et repliés."

